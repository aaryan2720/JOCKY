# ==============================================================================
# JOCKY Monorepo Root .gitignore
# Prevents secrets, build artifacts, dependencies, and caches from being committed
# ==============================================================================

# --- Secrets & Environment Variables ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12

# --- Node / Frontend ---
**/node_modules/
**/dist/
**/dist-ssr/
**/.eslintcache
**/.stylelintcache
**/.next/
**/.nuxt/
**/.cache/

# --- Python / Backend ---
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/build/
**/develop-eggs/
**/dist/
**/downloads/
**/eggs/
**/.eggs/
**/lib/
**/lib64/
**/parts/
**/sdist/
**/var/
**/wheels/
**/*.egg-info/
**/.installed.cfg
**/*.egg
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/
**/.tox/
**/.venv/
**/env/
**/venv/
**/ENV/
**/jocky_backend.egg-info/

# --- Go / Agent ---
**/agent/bin/
**/agent/dist/
**/bin/
**/*.exe
**/*.exe~
**/*.dll
**/*.so
**/*.dylib
**/*.test
**/*.out
**/vendor/

# --- Databases & Local Storage ---
**/*.sqlite
**/*.sqlite3
**/*.db
**/postgres_data/
**/redis_data/
**/*.rdb

# --- Logs & Temp ---
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.scratch/
**/scratch/
**/tmp/
**/temp/

# --- OS & IDE Metadata ---
.DS_Store
Thumbs.db
desktop.ini
**/.idea/
**/.vscode/
!**/.vscode/extensions.json
!**/.vscode/launch.json
!**/.vscode/settings.json
**/*.swp
**/*.swo
*~