# ==============================================================================
# JOCKY Environment Configuration (.env.example)
# Copy this file to .env before starting services
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (PostgreSQL) Configuration
POSTGRES_USER=jocky
POSTGRES_PASSWORD=jocky_secure_password
POSTGRES_DB=jocky_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jocky:jocky_secure_password@localhost:5432/jocky_db
# Sync DB URL for migrations / Alembic if needed
DATABASE_URL_SYNC=postgresql://jocky:jocky_secure_password@localhost:5432/jocky_db

# Redis / Task Queue (Optional Infrastructure)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Agent Transport Configuration
AGENT_REGISTRATION_TOKEN=jocky-agent-insecure-dev-token
AGENT_SERVER_URL=http://localhost:8000
AGENT_POLL_INTERVAL_SECONDS=5

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
